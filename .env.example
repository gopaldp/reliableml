# Environment Variables for ReliableML
# Copy this file to .env for local overrides

# Application environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# MLflow Settings
MLFLOW_TRACKING_URI=sqlite:///mlruns.db
MLFLOW_ARTIFACT_ROOT=./artifacts/mlruns
MLFLOW_EXPERIMENT_NAME=reliableml-sales-forecasting
MLFLOW_PORT=5000

# Model Serving Settings
MODEL_SERVICE_HOST=0.0.0.0
MODEL_SERVICE_PORT=8000
MODEL_REGISTRY_NAME=sales-demand-forecaster
MODEL_STAGE_OR_ALIAS=champion

# Paths
DATA_DIR=./data
REPORTS_DIR=./reports
ARTIFACTS_DIR=./artifacts
